# URL du projet Supabase (Project Settings → API), sans suffixe /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique publishable / anon (Project Settings → API) — jamais la service_role key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sans ces deux variables, l'app démarre en mode local avec des données mockées
# (aucune sauvegarde, aucune authentification).

# --- Stripe (mode TEST uniquement — clés sk_test_/pk_test_, jamais sk_live_/pk_live_) ---

# URL de base de l'app, utilisée pour les redirections Checkout / Customer Portal
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clé secrète Stripe (Dashboard → Developers → API keys), mode test — serveur uniquement
STRIPE_SECRET_KEY=sk_test_REMPLACEZ_PAR_VOTRE_CLE_SECRETE

# Clé publiable Stripe (Dashboard → Developers → API keys), mode test — utilisable côté client
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REMPLACEZ_PAR_VOTRE_CLE_PUBLIABLE

# Identifiant du prix (Dashboard → Product catalog) utilisé par la Checkout Session
STRIPE_PRICE_ID=price_REMPLACEZ_PAR_VOTRE_PRICE_ID

# Secret de signature webhook (donné par `stripe listen` en local, ou par le
# Dashboard → Developers → Webhooks une fois l'endpoint créé)
STRIPE_WEBHOOK_SECRET=whsec_REMPLACEZ_PAR_VOTRE_WEBHOOK_SECRET

# --- Supabase service_role (serveur uniquement, jamais exposée au client) ---

# Dashboard Supabase → Project Settings → API → service_role. Contourne la RLS :
# utilisée uniquement par la route webhook Stripe pour écrire dans companies sans
# utilisateur connecté. Ne jamais préfixer NEXT_PUBLIC_, ne jamais importer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Intégration Pennylane (serveur uniquement, jamais exposée au client) ---

# Clé de chiffrement (AES-256-GCM) des Company API Token Pennylane stockés en base, une par
# environnement. 32 octets encodés en base64 — générer avec : openssl rand -base64 32
# Ne jamais préfixer NEXT_PUBLIC_, ne jamais commiter, ne jamais réutiliser entre Preview/Prod.
PENNYLANE_TOKEN_ENCRYPTION_KEY=
