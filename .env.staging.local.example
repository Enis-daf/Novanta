# Environnement de test isolé « QANNT TEST — STAGING ».
# Copier vers .env.staging.local (ignoré par Git) et renseigner avec les valeurs du projet Supabase
# STAGING uniquement. Aucune de ces variables ne doit être ajoutée en Production.

# Active le garde-fou anti-prod (lib/environnementGuard.ts) et le bandeau « QANNT TEST — STAGING ».
NEXT_PUBLIC_NOVANTA_ENV=staging

# Ref du projet Supabase staging (la partie avant .supabase.co). Seul projet autorisé.
NEXT_PUBLIC_STAGING_SUPABASE_REF=

# Refs interdites, séparées par des virgules : tout projet qui n'est PAS le staging et vers lequel
# rien ne doit jamais être écrit (Production, base utilisée par .env.local...).
NEXT_PUBLIC_NOVANTA_FORBIDDEN_SUPABASE_REFS=

# Projet Supabase staging (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clé de chiffrement propre au staging — générer avec : openssl rand -base64 32
# Ne jamais réutiliser celle d'un autre environnement.
PENNYLANE_TOKEN_ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3001

# Chaîne de connexion Postgres du projet staging (Project Settings → Database → Connection string).
# Utilisée uniquement par les scripts npm staging:* ; jamais affichée, jamais journalisée.
STAGING_DATABASE_URL=

# Email de l'utilisateur de test créé dans Supabase Auth du projet staging.
STAGING_USER_EMAIL=

# Pennylane : le mode se choisit par la commande de lancement, pas dans ce fichier.
#   npm run dev:staging        -> Pennylane RÉEL (API officielle, token saisi dans Intégrations)
#   npm run dev:staging:mock   -> serveur mock local (npm run staging:mock dans un autre terminal)
# PENNYLANE_API_BASE_URL ne doit donc pas être définie ici.
