  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test lib/*.test.ts scripts/staging/*.test.ts",
    "dev:staging": "export PENNYLANE_API_BASE_URL= && node --env-file=.env.staging.local --import tsx scripts/staging/env.ts && node --env-file=.env.staging.local node_modules/next/dist/bin/next dev -p 3001",
    "dev:staging:mock": "export PENNYLANE_API_BASE_URL=http://localhost:4010 && node --env-file=.env.staging.local --import tsx scripts/staging/env.ts && node --env-file=.env.staging.local node_modules/next/dist/bin/next dev -p 3001",
    "staging:schema": "node --env-file=.env.staging.local --import tsx scripts/staging/schema.ts",
    "staging:seed": "node --env-file=.env.staging.local --import tsx scripts/staging/seed.ts",
    "staging:verifier": "node --env-file=.env.staging.local --import tsx scripts/staging/verifier.ts",
    "staging:mock": "node --import tsx scripts/staging/pennylane-mock.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "stripe": "^22.4.0",
    "svg2pdf.js": "^2.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3"
  }
}
